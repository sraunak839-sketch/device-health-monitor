[Unit]
Description=Embedded Linux Device Health Monitor Service
After=network.target

[Service]
Type=simple
User=raunak
WorkingDirectory=/home/raunak/device_health_monitor/build
ExecStart=/home/raunak/device_health_monitor/build/health_monitor
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target